# ─────────────────────────────────────────────────────────────────────────────
# Reno environment variables. Copy to `.env` and fill in.
# Phases 1–17 run fully locally on stubs — only DATABASE_URL + APP_URL are used.
# Phases 18–20 activate real integrations: set a key and that integration
# turns on behind its interface. Leave a key blank and the local fallback runs.
# Never commit real secrets — only this template is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres. Local dev: native Postgres or `docker compose up -d`.
# Production (Phase 18): paste your Neon connection string here instead.
DATABASE_URL="postgresql://localhost:5432/reno?schema=public"

# Base URL of the app (used for signer/pay/portal token links + Stripe redirects).
APP_URL="http://localhost:3000"

# ── Phase 18 — Auth (Clerk) ───────────────────────────────────────────────────
# Set both to route auth through Clerk; unset to use cookie-based dev auth.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# ── Phase 19 — Email (Resend) ─────────────────────────────────────────────────
# Set to send real email; unset logs to the server "outbox".
# RESEND_API_KEY=
# RESEND_FROM="Reno <noreply@yourdomain.com>"

# ── Phase 19 — AI (Anthropic Claude) ──────────────────────────────────────────
# Set to use live Claude; unset uses the local rule-based assistant.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL="claude-opus-4-8"

# ── Phase 19 — Storage (S3 / Cloudflare R2) ───────────────────────────────────
# Implement the Storage interface + gate getStorage() on S3_BUCKET (see GO_LIVE.md).
# S3_REGION=
# S3_BUCKET=
# S3_ENDPOINT=            # R2: https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Phase 19 — Background jobs (Inngest) ──────────────────────────────────────
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ── Phase 20 — Payments (Stripe) ──────────────────────────────────────────────
# Set to enable online invoice payment; the webhook records payments back.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Phase 20 — Accounting (QuickBooks Online) ─────────────────────────────────
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=
