# ─────────────────────────────────────────────────────────────────────────────
# Reno environment variables. Copy to `.env` and fill in.
# Phases 1–17 run fully locally with stubs — only DATABASE_URL is required.
# Real integration keys are added in Phases 18–20.
# ─────────────────────────────────────────────────────────────────────────────

# Local Postgres (matches docker-compose.yml). Start it with `docker compose up -d`.
DATABASE_URL="postgresql://reno:reno@localhost:5433/reno?schema=public"

# Base URL of the app (used for signer/pay/portal token links).
APP_URL="http://localhost:3000"

# ── Phase 18 — Auth (Clerk) + production database (Neon) ──────────────────────
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# (Neon) DATABASE_URL=

# ── Phase 19 — Storage (S3/R2), Email (Resend), AI (Anthropic), Jobs (Inngest) ─
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# RESEND_API_KEY=
# ANTHROPIC_API_KEY=
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ── Phase 20 — Payments (Stripe) + Accounting (QuickBooks Online) ─────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=
